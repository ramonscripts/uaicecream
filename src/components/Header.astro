---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { menu as menuItems } from '../data/site.js';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<div class="site-header">
  <!-- camada clara: é a que recebe cliques e teclado -->
  <header class="ds-header site-header__base">
    <a class="site-home" href="/" aria-label="uaice cream, início"><Logo tone="light" size={28} decorative /></a>
    <span class="ds-header__sp"></span>
    <!-- carrinho sempre à mão + botão que abre o menu em tela cheia (celular e computador) -->
    <a class="ds-header__btn" href="/carrinho" aria-label="carrinho">
      <Icon name="carrinho" /><span data-cart-count>0</span>
    </a>
    <button class="ds-header__btn" type="button" data-menu-open aria-expanded="false" aria-controls="site-menu">
      <Icon name="menu" /><span>menu</span>
    </button>
  </header>
  <!-- camada escura: cópia só visual, recortada pelo site.js onde há faixa escura atrás; cliques passam para a clara -->
  <div class="ds-header site-header__dark" aria-hidden="true" inert>
    <span class="site-home"><Logo tone="dark" size={28} decorative /></span>
    <span class="ds-header__sp"></span>
    <span class="ds-header__btn"><Icon name="carrinho" /><span data-cart-count>0</span></span>
    <span class="ds-header__btn"><Icon name="menu" /><span>menu</span></span>
  </div>
</div>

<!-- Menu em tela cheia: um item por linha; grupos abrem os subitens logo abaixo. -->
<div class="site-menu" id="site-menu" role="dialog" aria-modal="true" aria-label="menu" data-theme="dark" hidden>
  <div class="ds-header site-menu__top">
    <span class="site-home"><Logo tone="dark" size={28} /></span>
    <span class="ds-header__sp"></span>
    <button class="ds-header__btn" type="button" data-menu-close><Icon name="fechar" /><span>fechar</span></button>
  </div>
  <ul class="site-menu__list">
    {menuItems.map(({ href, label, icon, items }, i) => (
      <li style={`--i:${i}`}>
        {items ? (
          <>
            <button class="site-menu__item" type="button" aria-expanded="false" aria-controls={`site-menu-sub-${i}`}>
              <Icon name={icon} size={28} />
              <span class="ds-link ds-link--dark">{label}</span>
              <Icon name="abrir" size={24} class="site-menu__chev" />
            </button>
            <ul class="site-menu__sub" id={`site-menu-sub-${i}`} hidden>
              {items.map(([subHref, subLabel]) => (
                <li><a class="ds-link ds-link--dark" href={subHref} aria-current={subHref === path ? 'page' : undefined}>{subLabel}</a></li>
              ))}
            </ul>
          </>
        ) : (
          <a class="site-menu__item" href={href} aria-current={href === path ? 'page' : undefined}>
            <Icon name={icon} size={28} />
            <span class="ds-link ds-link--dark">{label}</span>
          </a>
        )}
      </li>
    ))}
  </ul>
</div>

<script>
  import { count } from '../scripts/cart.js';
  const update = () => document.querySelectorAll('[data-cart-count]').forEach((el) => (el.textContent = String(count())));
  window.addEventListener('cart:change', update);
  window.addEventListener('storage', update); // outra aba mudou o carrinho
  update();

  const menu = document.getElementById('site-menu');
  const openBtn = document.querySelector('[data-menu-open]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  function setOpen(open) {
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('site-menu-open', open); // libera a rolagem já ao fechar (links com #)
    if (open) {
      menu.classList.remove('is-closing');
      menu.hidden = false;
      menu.querySelector('.site-menu__item').focus();
      return;
    }
    openBtn.focus();
    if (menu.hidden || reduce.matches) { menu.hidden = true; return; }
    // fechar com animação: esconde só quando a animação do painel termina
    menu.classList.add('is-closing');
    const finish = () => {
      menu.removeEventListener('animationend', onEnd);
      clearTimeout(timer);
      if (menu.classList.contains('is-closing')) { menu.hidden = true; menu.classList.remove('is-closing'); }
    };
    const onEnd = (e) => { if (e.target === menu) finish(); }; // ignora o fim da animação dos itens
    const timer = setTimeout(finish, 600); // garantia caso o navegador não dispare animationend
    menu.addEventListener('animationend', onEnd);
  }
  openBtn.addEventListener('click', () => setOpen(true));
  menu.querySelector('[data-menu-close]').addEventListener('click', () => setOpen(false));
  menu.addEventListener('click', (e) => {
    if (e.target.closest('a')) return setOpen(false); // fecha também em links com # na mesma página
    const group = e.target.closest('button[aria-controls]');
    if (group) {
      const open = group.getAttribute('aria-expanded') !== 'true';
      group.setAttribute('aria-expanded', String(open));
      document.getElementById(group.getAttribute('aria-controls')).hidden = !open;
    }
  });
  document.addEventListener('keydown', (e) => {
    if (menu.hidden) return;
    if (e.key === 'Escape') setOpen(false);
    if (e.key === 'Tab') { // mantém o foco dentro do menu
      const f = [...menu.querySelectorAll('a, button')].filter((el) => el.offsetParent !== null); // ignora subitens fechados
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
</script>
