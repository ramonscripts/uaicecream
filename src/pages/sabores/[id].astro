---
// Página de detalhes de um sabor. Leva para a página de compra do mesmo sabor.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Feature from '../../components/Feature.astro';
import ProfileCard from '../../components/ProfileCard.astro';
import Cols from '../../components/Cols.astro';
import Intro from '../../components/Intro.astro';
import Button from '../../components/Button.astro';
import Pontos from '../../components/Pontos.astro';
import { sabores, ficha } from '../../data/site.js';

export function getStaticPaths() {
  return sabores.map((s) => ({ params: { id: s.id }, props: { s } }));
}
const { s } = Astro.props;
const outros = sabores.filter((o) => o.id !== s.id);
---
<Base title={`${s.name} · uaice fit`} description={s.desc}>
  <Section class="sabor-hero media-fit">
    <Feature title={s.name} body={s.about} image={`/img/sabores/${s.id}.jpg`} alt={s.name}>
      <div class="site-actions site-actions--start sabor-acoes--pc">
        <Button href="#onde-encontrar">onde encontrar</Button>
        <Button href={`/comprar/${s.id}`} variant="secondary">pedir para minha loja</Button>
      </div>
    </Feature>
    <!-- cópia para o celular: lá a foto ocupa a tela e os botões ficam abaixo dela, não por cima -->
    <div class="site-actions site-actions--start sabor-acoes--cel">
      <Button href="#onde-encontrar">onde encontrar</Button>
      <Button href={`/comprar/${s.id}`} variant="secondary">sou lojista</Button>
    </div>
    <div class="stack-sm">
      <span class="t-label">em cada picolé</span>
      <Cols cards items={ficha} />
    </div>
  </Section>

  <Section>
    <Pontos />
  </Section>

  <Section>
    <div class="rail">
      <div class="rail-head">
        <Intro label="outros sabores" title={`os outros ${outros.length} sabores`} />
        <div class="rail-nav">
          <button type="button" class="rail-btn" data-rail="prev" aria-label="sabores anteriores"><svg width="16" height="16" style="transform:scaleX(-1)" aria-hidden="true"><use href="#arrow" /></svg></button>
          <button type="button" class="rail-btn" data-rail="next" aria-label="próximos sabores"><svg width="16" height="16" aria-hidden="true"><use href="#arrow" /></svg></button>
        </div>
      </div>
      <div class="site-grid site-grid--3 site-grid--rail">
        {outros.map((o) => <ProfileCard name={o.name} cta="ver sabor" href={`/sabores/${o.id}`} image={`/img/sabores/${o.id}-home.jpg`} alt={o.name} />)}
      </div>
    </div>
  </Section>
</Base>
