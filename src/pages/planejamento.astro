---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import Feature from '../components/Feature.astro';
import ProfileCard from '../components/ProfileCard.astro';
import Cols from '../components/Cols.astro';
import Rows from '../components/Rows.astro';
import Intro from '../components/Intro.astro';
import Logo from '../components/Logo.astro';
import Button from '../components/Button.astro';
import Qr from '../components/Qr.astro';
import { equipe, ficha } from '../data/site.js';
---
<Base title="planejamento · uaice fit" description="Planejamento de marketing da linha uaice fit, feito pela Consultoria Raiz.">
  <Section stack={false}>
    <Hero title="planejamento de marketing da linha uaice fit" lead="Picolés recheados de 60 g, com proteína e sem adição de açúcar, para quem passou a comer menos e ainda quer um doce.">
      <Logo slot="top" line="fit" />
      <div class="site-actions">
        <Button href="/comprar">loja para lojistas</Button>
        <Button href="#produto" variant="secondary">ver o planejamento</Button>
      </div>
      <Qr />
    </Hero>
  </Section>

  <Section id="produto">
    <Feature label="o produto" title="picolé de 60 g com recheio" cta="ver os sabores" href="/#sabores"
      body="A linha de picolés recheados da uaice cream tem base de iogurte proteico e recheio cremoso. O sabor principal é o romeu e julieta, e há mais cinco sabores." />
    <Cols items={ficha} />
    <p class="t-caption">Metas de desenvolvimento, que dependem de testes de formulação e validação nutricional. Alegações no rótulo seguem a RDC nº 429/2020 e a IN nº 75/2020 da Anvisa.</p>
  </Section>

  <Section id="mercado">
    <Feature reverse label="análise situacional" title="as pessoas estão comendo menos doce"
      body="Com a popularização das canetas emagrecedoras, muita gente cortou doces e passou a buscar proteína. Quem come menos quer que cada porção traga mais nutrientes, e a uaice fit é uma sobremesa com proteína." />
    <Cols items={[
      ['33%', 'dos domicílios brasileiros tinham, em fevereiro de 2026, alguém que usa ou já usou canetas emagrecedoras. No fim de 2025 eram 26%.'],
      ['95%', 'desses domicílios reduziram o consumo de ao menos uma categoria de alimentos.'],
      ['70%', 'diminuíram o consumo de doces, snacks e salgadinhos.'],
      ['+9,1%', 'de alta projetada para os suplementos proteicos, enquanto chocolates, biscoitos e balas caem.'],
    ]} />
    <p class="t-caption">Fontes: Instituto Locomotiva/ICTQ; Scanntech; consenso de sociedades médicas e de nutrição dos EUA sobre medicamentos GLP-1.</p>
  </Section>

  <Section id="concorrencia">
    <Feature label="concorrência" title="picolé artesanal com proteína"
      body="O Piracanjuba ProForce, lançado em 2026, tem 10 g de proteína, zero lactose e não leva açúcar adicionado, mas a distribuição inicial não inclui o Triângulo Mineiro. Para o grupo, os proteicos parecem suplemento e vêm em pote, o que facilita comer mais de uma porção. A uaice fit tem o sabor e o recheio de um picolé artesanal, com a proteína e o pouco açúcar desses produtos." />
    <div class="stack-sm">
      <span class="t-label">análise swot</span>
      <Cols items={[
        ['forças', 'Porção pequena, de 60 g. Recheio cremoso, que os picolés proteicos comuns não têm. Marca e sabores de Minas. Venda em lojas que já atendem quem faz dieta ou treina.'],
        ['fraquezas', 'Marca nova. Ingredientes proteicos mais caros. Dependência da cadeia de frio no transporte e nas lojas. Produção inicial pequena.'],
        ['oportunidades', 'Uso crescente de canetas emagrecedoras. Mais procura por produtos proteicos. Lojas naturais e de suplementos atrás de novidades para o freezer. Poucas marcas regionais de picolé proteico.'],
        ['ameaças', 'Queda no consumo de doces. Grandes marcas lançando picolés proteicos. Variação de preço do leite e das proteínas. Regras da Anvisa para alegações nutricionais no rótulo.'],
      ]} />
    </div>
  </Section>

  <Section id="publico" stack={false}>
    <Feature reverse label="público-alvo" title="quem compra"
      body="Adultos de 25 a 50 anos, das classes B- e C+, nas maiores cidades do Triângulo Mineiro, que estão emagrecendo com canetas, dieta ou academia. Compram em lojas de produtos naturais e de suplementos, vão à academia e a cafeterias saudáveis e comem o picolé no meio da tarde, depois do treino ou após o almoço." />
  </Section>

  <Section id="metas">
    <Intro label="objetivos e metas" title="metas para os primeiros seis meses" />
    <Cols cols={2} items={[
      ['30 lojas', 'vendendo a uaice fit no Triângulo Mineiro até o fim do sexto mês.'],
      ['9.000 unidades', 'vendidas nos primeiros seis meses, cerca de 40% delas de romeu e julieta.'],
    ]} />
    <div class="stack-sm">
      <span class="t-label">estratégias dos 4 ps</span>
      <Cols items={[
        ['produto', 'Porção pequena, com proteína e recheio. Um sabor principal mineiro e cinco que o público já conhece.'],
        ['preço', 'Acima do picolé comum, porque tem proteína e recheio.'],
        ['praça', 'Só em lojas escolhidas, sem loja própria. A uaice empresta o freezer.'],
        ['promoção', 'Redes sociais mostrando o recheio e o tamanho da porção, e degustação nas lojas.'],
      ]} />
    </div>
  </Section>

  <Section id="logistica">
    <Feature label="planos de ação" title="preço e como o picolé chega ao freezer"
      body="Os picolés vão para lojas de produtos naturais e de suplementos, empórios, cafeterias e academias. Cada loja recebe emprestado um freezer pequeno com a marca da uaice." />
    <div class="stack-sm">
      <Cols cols={3} items={[
        ['R$ 10,90', 'preço sugerido ao consumidor, por unidade de 60 g'],
        ['R$ 6,90', 'preço de venda ao lojista'],
        ['R$ 4,00', 'de margem por unidade para o lojista'],
      ]} />
      <p class="t-caption">O valor fica acima de um picolé artesanal comum. É uma estimativa, e não um cálculo contábil definitivo.</p>
    </div>
    <div class="stack-sm">
      <span class="t-label">expansão no triângulo mineiro</span>
      <Rows items={[
        ['lançamento', 'Uberaba e Uberlândia, as duas maiores cidades.'],
        ['mês 4', 'Araxá, Araguari e Ituiutaba.'],
        ['depois do semestre', 'Outras regiões.'],
        ['reposição', 'Pedidos pelo WhatsApp Business, com entrega semanal em veículo refrigerado.'],
      ]} />
    </div>
  </Section>

  <Section id="promocao">
    <Feature reverse label="promoção" title="o que a comunicação diz"
      body="Os posts mostram a porção pequena, a proteína e o recheio. Não prometem emagrecimento nem citam medicamentos, porque a Anvisa proíbe alegações medicinais no rótulo de alimentos e o picolé também é para quem não faz dieta." />
    <Cols cols={3} items={[
      ['instagram', 'Usado por quem treina e pelas lojas que vendem a uaice fit.'],
      ['tiktok', 'Vídeos curtos da mordida, com o recheio aparecendo.'],
      ['whatsapp business', 'Conversa com os lojistas e pedidos de reposição.'],
    ]} />
  </Section>

  <Section id="monitoramento">
    <Intro label="monitoramento e controle" title="como o grupo acompanha os resultados">
      <p>Todo mês, com os mesmos números das metas.</p>
    </Intro>
    <Rows items={[
      ['lojas vendendo', 'Comparadas às 30 previstas para o sexto mês.'],
      ['unidades vendidas por sabor', 'Comparadas às 9.000 do semestre, com o romeu e julieta olhado à parte.'],
      ['pedidos de reposição', 'Frequência registrada pelo WhatsApp Business.'],
      ['cadeia de frio', 'Perdas por falha na refrigeração.'],
      ['degustações', 'Retorno de lojistas e consumidores.'],
      ['ajustes', 'Se um sabor vender bem abaixo dos outros ou uma loja não girar o estoque, o grupo troca os sabores enviados ou a divulgação naquela loja.'],
    ]} />
  </Section>

  <Section id="equipe">
    <Intro label="equipe" title="consultoria raiz">
      <p>Grupo da Universidade de Uberaba que fez este planejamento.</p>
    </Intro>
    <div class="site-grid">
      {equipe.map((m) => <ProfileCard name={m.name} cta={m.role} caption={`RA ${m.ra}`} image={m.image} alt={m.name} />)}
    </div>
  </Section>
</Base>
