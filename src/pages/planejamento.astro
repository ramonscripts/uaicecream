---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Hero from '../components/Hero.astro';
import Feature from '../components/Feature.astro';
import ProfileCard from '../components/ProfileCard.astro';
import Cols from '../components/Cols.astro';
import Rows from '../components/Rows.astro';
import Intro from '../components/Intro.astro';
import Logo from '../components/Logo.astro';
import Button from '../components/Button.astro';
import Qr from '../components/Qr.astro';
import { equipe, ficha } from '../data/site.js';
---
<Base title="planejamento · uaice fit" description="Planejamento de marketing da linha uaice fit, feito pela Consultoria Raiz.">
  <Section stack={false}>
    <Hero title="planejamento de marketing da linha uaice fit" lead="Picolés recheados de 60 g da uaice cream, com proteína e sem adição de açúcar, para quem passou a comer menos e ainda quer um doce.">
      <Logo slot="top" line="fit" />
      <div class="site-actions">
        <Button href="/comprar">loja para lojistas</Button>
        <Button href="#produto" variant="secondary">ver o planejamento</Button>
      </div>
      <Qr />
    </Hero>
  </Section>

  <Section id="produto">
    <Feature label="o produto" title="picolé de 60 g com recheio" cta="ver os sabores" href="/#sabores"
      body="A uaice fit é a linha de picolés recheados da uaice cream: 60 g, base de iogurte proteico e recheio cremoso, sem adição de açúcar. O sabor principal é o romeu e julieta, e a linha tem mais cinco sabores." />
    <Cols items={ficha} />
    <p class="t-caption">Metas de desenvolvimento, que dependem de testes de formulação e validação nutricional. Alegações no rótulo seguem a RDC nº 429/2020 e a IN nº 75/2020 da Anvisa.</p>
  </Section>

  <Section id="mercado">
    <Feature reverse label="análise situacional" title="as pessoas estão comendo menos doce"
      body="Com a popularização das canetas emagrecedoras, muita gente cortou doces e passou a buscar proteína. Quem come menos precisa que cada refeição traga mais nutrientes, e a uaice fit é uma sobremesa com proteína." />
    <Cols items={[
      ['33%', 'dos domicílios brasileiros tinham, em fevereiro de 2026, alguém que usa ou já usou canetas emagrecedoras, contra 26% no fim de 2025.'],
      ['95%', 'desses domicílios reduziram o consumo de ao menos uma categoria de alimentos.'],
      ['70%', 'diminuíram o consumo de doces, snacks e salgadinhos.'],
      ['+9,1%', 'de alta projetada para os suplementos proteicos, enquanto chocolates, biscoitos e balas caem.'],
    ]} />
    <p class="t-caption">Fontes: Instituto Locomotiva/ICTQ; Scanntech; consenso de sociedades médicas e de nutrição dos EUA sobre medicamentos GLP-1.</p>
  </Section>

  <Section id="concorrencia">
    <Feature label="concorrência" title="picolé artesanal com proteína"
      body="Picolés e sorvetes proteicos já existem, como o Piracanjuba ProForce, lançado em 2026 com 10 g de proteína, zero lactose e sem adição de açúcar, cuja distribuição inicial não inclui o Triângulo Mineiro. Na avaliação do grupo, esses produtos seguem o visual de suplemento, e o pote facilita comer mais de uma porção. A uaice fit tem o sabor e o recheio de um picolé artesanal, com a proteína e o pouco açúcar desses produtos." />
    <div class="stack-sm">
      <span class="t-label">análise swot</span>
      <Cols items={[
        ['forças', 'Porção pequena, de 60 g. Recheio cremoso, que os picolés proteicos comuns não têm. Marca e sabores de Minas. Venda em lojas que já atendem quem está de dieta ou treina.'],
        ['fraquezas', 'Marca nova e desconhecida. Custo maior de ingredientes proteicos. Dependência da cadeia de frio no transporte e nas lojas. Volume de produção inicial pequeno.'],
        ['oportunidades', 'Crescimento do uso de canetas emagrecedoras. Alta na procura por produtos proteicos. Lojas de produtos naturais e de suplementos procurando produtos novos para o freezer. Poucas marcas regionais de picolé proteico.'],
        ['ameaças', 'Queda geral no consumo de doces. Grandes marcas lançando picolés proteicos. Variação de preço do leite e das proteínas. Regras da Anvisa para alegações nutricionais no rótulo.'],
      ]} />
    </div>
  </Section>

  <Section id="publico" stack={false}>
    <Feature reverse label="público-alvo" title="quem compra"
      body="Adultos de 25 a 50 anos, das classes B- e C+, moradores das maiores cidades do Triângulo Mineiro, que estão emagrecendo com canetas, dieta ou academia. Compram em lojas de produtos naturais e de suplementos, frequentam academia e cafeterias saudáveis e consomem o picolé no meio da tarde, depois do treino ou como sobremesa após o almoço." />
  </Section>

  <Section id="metas">
    <Intro label="objetivos e metas" title="metas para os primeiros seis meses" />
    <Cols cols={2} items={[
      ['30 lojas', 'vendendo a uaice fit no Triângulo Mineiro até o fim do sexto mês.'],
      ['9.000 unidades', 'vendidas nos primeiros seis meses, com o romeu e julieta respondendo por cerca de 40% das vendas.'],
    ]} />
    <div class="stack-sm">
      <span class="t-label">estratégias dos 4 ps</span>
      <Cols items={[
        ['produto', 'Porção pequena, com proteína e recheio. O sabor principal é mineiro, e os outros cinco são sabores que o público já conhece.'],
        ['preço', 'Preço acima do picolé comum, porque tem proteína e recheio.'],
        ['praça', 'Venda só em lojas escolhidas, sem loja própria. A uaice empresta o freezer à loja.'],
        ['promoção', 'Redes sociais mostrando o recheio e o tamanho da porção, e degustação nas lojas.'],
      ]} />
    </div>
  </Section>

  <Section id="logistica">
    <Feature label="planos de ação" title="preço e como o picolé chega ao freezer"
      body="A uaice cream não terá loja própria. Os picolés vão só para lojas de produtos naturais, lojas de suplementos, empórios, cafeterias e academias. Cada loja recebe emprestado um freezer pequeno com a marca da uaice." />
    <div class="stack-sm">
      <Cols cols={3} items={[
        ['R$ 10,90', 'preço sugerido ao consumidor, por unidade de 60 g'],
        ['R$ 6,90', 'preço de venda ao lojista'],
        ['R$ 4,00', 'de margem por unidade para o lojista'],
      ]} />
      <p class="t-caption">O valor fica acima de um picolé artesanal comum. O preço é uma estimativa, e não um cálculo contábil definitivo.</p>
    </div>
    <div class="stack-sm">
      <span class="t-label">expansão no triângulo mineiro</span>
      <Rows items={[
        ['lançamento', 'Uberaba e Uberlândia, as duas maiores cidades.'],
        ['mês 4', 'Expansão para Araxá, Araguari e Ituiutaba.'],
        ['depois do semestre', 'Expansão para outras regiões.'],
        ['reposição', 'Pedidos pelo WhatsApp Business, com entrega semanal em veículo refrigerado.'],
      ]} />
    </div>
  </Section>

  <Section id="promocao">
    <Feature reverse label="promoção" title="o que a comunicação diz"
      body="Os posts mostram uma porção pequena, com proteína e bastante recheio. A comunicação não promete emagrecimento nem cita medicamentos: a Anvisa proíbe que o rótulo de um alimento indique propriedades medicinais, e o picolé também é para quem não está de dieta." />
    <Cols cols={3} items={[
      ['instagram', 'Muito usado por quem treina e pelas lojas que vendem a uaice fit.'],
      ['tiktok', 'Vídeos curtos do picolé sendo mordido e do recheio aparecendo.'],
      ['whatsapp business', 'Conversa com os lojistas e pedidos de reposição.'],
    ]} />
  </Section>

  <Section id="monitoramento">
    <Intro label="monitoramento e controle" title="como o grupo acompanha os resultados">
      <p>O acompanhamento é mensal e usa os mesmos números das metas.</p>
    </Intro>
    <Rows items={[
      ['lojas vendendo', 'Comparadas às 30 previstas para o sexto mês.'],
      ['unidades vendidas por sabor', 'Comparadas às 9.000 previstas para o semestre, olhando em separado o romeu e julieta.'],
      ['pedidos de reposição', 'Frequência registrada pelo WhatsApp Business.'],
      ['cadeia de frio', 'Perdas por falha na refrigeração.'],
      ['degustações', 'Retorno de lojistas e consumidores.'],
      ['ajustes', 'Se um sabor vender bem abaixo dos demais ou uma loja não vender o estoque, o grupo muda os sabores enviados ou a ação de divulgação naquela loja.'],
    ]} />
  </Section>

  <Section id="equipe">
    <Intro label="equipe" title="consultoria raiz">
      <p>Grupo da Universidade de Uberaba que montou este planejamento para lançar a uaice fit em lojas de produtos naturais e de suplementos do Triângulo Mineiro.</p>
    </Intro>
    <div class="site-grid">
      {equipe.map((m) => <ProfileCard name={m.name} cta={m.role} caption={`RA ${m.ra}`} image={m.image} alt={m.name} />)}
    </div>
  </Section>
</Base>
