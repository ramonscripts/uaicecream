---
// Loja para lojistas: condições de venda e os sabores, vendidos em caixas fechadas.
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Hero from '../../components/Hero.astro';
import Media from '../../components/Media.astro';
import Tag from '../../components/Tag.astro';
import Button from '../../components/Button.astro';
import Cols from '../../components/Cols.astro';
import { sabores, PRICE, SUGERIDO, CAIXA, PRICE_CAIXA, MINIMO, brl } from '../../data/site.js';
---
<Base title="loja para lojistas · uaice fit" description="Compra da uaice fit para lojas de produtos naturais, suplementos, empórios, cafeterias e academias de Uberaba e Uberlândia.">
  <Section>
    <Hero title="loja para lojistas" lead="Venda da uaice fit para lojas de Uberaba e Uberlândia. Esta loja é uma demonstração e não cobra nada." />
    <Cols cards items={[
      [brl(PRICE), `por unidade para a loja. Revenda sugerida: ${brl(SUGERIDO)}.`],
      [`${CAIXA} unidades`, "por caixa, todas do mesmo sabor."],
      [`${MINIMO} caixas`, "de pedido mínimo, com sabores iguais ou diferentes."],
      ["freezer emprestado", "e entrega semanal em veículo refrigerado."],
    ]} />
    <div class="site-grid site-grid--shop">
      {sabores.map((s) => (
        <article class="product" id={s.id}>
          <div class="ds-card">
            <a href={`/comprar/${s.id}`} tabindex="-1" aria-hidden="true" class="product-media"><Media image={`/img/sabores/${s.id}.jpg`} alt="" /></a>
            {s.tags.length > 0 && <div class="product-tags">{s.tags.map((t) => <Tag tone="emerald">{t}</Tag>)}</div>}
            <h2 class="t-heading-sm">{s.name}</h2>
            <p class="t-small">{s.desc}</p>
            <div class="product-foot">
              <span class="product-price"><span class="t-body-strong">{brl(PRICE_CAIXA)}</span> <span class="t-caption">caixa com {CAIXA}</span></span>
              <Button variant="secondary" href={`/comprar/${s.id}`} aria-label={`pedir ${s.name}`}>pedir</Button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </Section>
</Base>
